# Copy to .env for local runs. In GitHub Actions set these as repo Secrets instead.

# Supabase — Postgres connection string (Python/psycopg).
# *** GitHub Actions MUST use the Session pooler string (IPv4) ***
# Supabase -> Connect -> Session pooler. The direct db.* host is IPv6-only and
# fails on GitHub runners with "Network is unreachable" (2600:... address).
DATABASE_URL=postgresql://postgres.ibmhrlcocptfjlwmrkdo:[YOUR-PASSWORD]@aws-1-<REGION>.pooler.supabase.com:5432/postgres

# Local-only alternative: the direct connection string also works if your
# network has IPv6:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ibmhrlcocptfjlwmrkdo.supabase.co:5432/postgres

# Percent-encode special characters in the password (e.g. @ -> %40, # -> %23).

# Alternatives to DATABASE_URL: password + pooler host (from Connect -> Session pooler).
# SUPABASE_DB_PASSWORD=
# SUPABASE_POOLER_HOST=aws-1-<REGION>.pooler.supabase.com

# Discord alert webhook
DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Bot mode
MARKET=US
ALERT_ONLY=true
INITIAL_CAPITAL_USD=258
