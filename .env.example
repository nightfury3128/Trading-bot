# Copy to .env for local runs. In GitHub Actions set these as repo Secrets instead.

# Supabase — direct Postgres connection string (Python/psycopg).
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
# Percent-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ibmhrlcocptfjlwmrkdo.supabase.co:5432/postgres
# If GitHub Actions can't reach the IPv6-only direct host, use the Session pooler
# string from Supabase -> Connect instead (*.pooler.supabase.com:5432,
# user postgres.ibmhrlcocptfjlwmrkdo) as the DATABASE_URL secret.

# Alternative to DATABASE_URL: just the password, host/db/user default to the project above.
# SUPABASE_DB_PASSWORD=

# Discord alert webhook
DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Bot mode
MARKET=US
ALERT_ONLY=true
INITIAL_CAPITAL_USD=258
